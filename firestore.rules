rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checking Admin without crashing if user doc missing
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          )
        )
      );
    }

    // ---------------- WILDCARD OVERRIDE (FOR ADMIN DASHBOARD & SUBCOLLECTIONS) ----------------
    // Hii inahakikisha collectionGroup queries na subcollections zote zinasomwa na kuandikwa bila kukwama
    match /{path=**} {
      allow read, write: if isSignedIn();
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'status']))
      );
      allow delete: if isAdmin();
    }

    // ---------------- teachers (Legacy / Existing Collection Support) ----------------
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------- materials ----------------
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'PENDING_REVIEW';
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    // ---------------- subscriptions ----------------
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions / Payment Webhook pekee
    }

    // ---------------- payouts ----------------
    match /payouts/{payoutId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions pekee
    }

    // ---------------- downloads ----------------
    match /downloads/{downloadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------- notifications ----------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
  }
}
